{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run kill-server",
    "dev": "concurrently \".venv/bin/python server/app.py\" \"vite\"",
    "build": "tsc -b && vite build",
    "preserver": "npm run kill-server",
    "server": ".venv/bin/python server/app.py",
    "server:prod": ".venv/bin/gunicorn --chdir server --bind 0.0.0.0:${PORT:-3001} --worker-class gthread --workers 1 --threads 16 --timeout 0 --access-logfile - --error-logfile - app:app",
    "setup:server": "python3.12 -m venv .venv && .venv/bin/python -m pip install -r server/requirements.txt",
    "kill-server": "lsof -ti tcp:3001 | xargs kill 2>/dev/null; exit 0",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.16.0",
    "plotly.js-dist-min": "^3.5.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
